# Copy to .env (never commit .env). Only the publishable key belongs in the app — never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>

# Only needed for Android release builds (Expo Go has its own Maps key). Set it as an EAS environment variable.
# GOOGLE_MAPS_ANDROID_API_KEY=
